  "_routing_comment": [
    "The two vectors below pin the ROUTING half of the contract, which the",
    "gateway (Go) and agent-service (Python) both compute. Both must reach",
    "the same replica for one working copy: if they disagree, two writers",
    "end up on one Git worktree, which is what the lease exists to prevent.",
    "normalize_addr mirrors lease.NormalizeAddr /",
    "datacode_common.lease.normalize_runtime_addr; stable_hash mirrors",
    "lease.StableHashIndex / datacode_common.lease.stable_hash_index (FNV-1a",
    "32-bit over the lease key, modulo the candidate count)."
  ],
  "normalize_addr": [
    {"addr": "10.1.2.3:8002", "expected": "http://10.1.2.3:8002", "why": "holder stores host:port; the scheme is the caller's concern"},
    {"addr": "workspace-runtime-0.runtime:8002", "expected": "http://workspace-runtime-0.runtime:8002", "why": "pod DNS name"},
    {"addr": "http://10.1.2.3:8002/", "expected": "http://10.1.2.3:8002", "why": "trailing slash would double up when a path is appended"},
    {"addr": "https://runtime.internal:8443", "expected": "https://runtime.internal:8443", "why": "an explicit scheme passes through so TLS needs no code change"},
    {"addr": "", "expected": "", "why": "nothing to dial"}
  ],
  "stable_hash": [
