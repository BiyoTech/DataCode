        <mxCell id="2" value="&lt;b&gt;DataCode 2.0 架构总览&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;蓝色 = 无状态服务（自由 HPA）&lt;br&gt;橙色 = 工作区亲和服务（租约绑定）&lt;br&gt;紫色 = 单例控制面（Dagster 官方约束）&lt;br&gt;绿色 = 一次性沙箱执行体&lt;br&gt;灰色 = 存储 / 外部依赖&lt;br&gt;&lt;br&gt;&lt;b&gt;规模目标&lt;/b&gt;：1000 租户 × 1000 子用户&lt;br&gt;= 10^6 用户，日活 5%，5 个 Cell，每 Cell ~200 租户" style="text;html=1;strokeColor=#8E8E93;fillColor=#F2F2F7;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="40" width="360" height="215" as="geometry" />
        </mxCell>
        <mxCell id="3" value="Frontend (Vue 3 + TS)&lt;br&gt;i18n zh/en · 用户时区可配置" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" parent="1" vertex="1">
