  <diagram id="p2-lease" name="2-工作区租约机制">
    <mxGraphModel dx="1434" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;工作区租约（Workspace Lease）&lt;/b&gt;&lt;br&gt;&lt;br&gt;lease_key = {tenant}/{workspace}/{user}/{env}&lt;br&gt;  （即工作副本的规范路径）&lt;br&gt;&lt;br&gt;Redis 键：&lt;br&gt;  {prefix}:{cell}:lease:{key} → runtime_id  EX 120&lt;br&gt;  {prefix}:{cell}:rt:{id} → 心跳(addr/leases/load) EX 30&lt;br&gt;&lt;br&gt;&lt;b&gt;TTL 是 crash 恢复界，不是操作超时&lt;/b&gt;：&lt;br&gt;watchdog 每 TTL/3 续期，apply 可跑数小时；&lt;br&gt;实例崩溃后 TTL 到期，租约自动可被接管。" style="text;html=1;strokeColor=#d79b00;fillColor=#fff9f0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="430" height="200" as="geometry" />
        </mxCell>
        <mxCell id="3" value="edge-gateway&lt;br&gt;&lt;b&gt;LeaseRouter 中间件&lt;/b&gt;&lt;br&gt;解析 lease_key → 查租约 → 直连 Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="590" y="60" width="300" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="control-service&lt;br&gt;&lt;b&gt;LeaseController&lt;/b&gt;&lt;br&gt;分配 / 回收 / 扩缩容编排" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="200" y="220" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="5" value="Cell Redis&lt;br&gt;lease:{key} → runtime_id（SET NX EX）&lt;br&gt;rt:{id} → 实例心跳与容量&lt;br&gt;lease:claim:{key} → 防惊群锁" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;boundedLbl=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="220" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="6" value="workspace-runtime #1&lt;br&gt;租约 16 / 16（满，不再接新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="140" y="420" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7" value="workspace-runtime #2&lt;br&gt;租约 9 / 16（可接新）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="440" y="420" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="8" value="workspace-runtime #3&lt;br&gt;draining（capacity=0）&lt;br&gt;等租约自然过期后下线" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;dashed=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="740" y="420" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="20" value="一个租约 = 四件资源（随租约一起创建与回收）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacing=6;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="140" y="610" width="880" height="180" as="geometry" />
        </mxCell>
        <mxCell id="21" value="worktree&lt;br&gt;Pod 本地 NVMe&lt;br&gt;.repo + envs/{env}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="180" y="670" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="22" value="MetadataContext&lt;br&gt;runtime 内存（只读）&lt;br&gt;模型/列/依赖/血缘" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="400" y="670" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="23" value="SqlMeshExecutor&lt;br&gt;可执行 SQLMesh Context&lt;br&gt;P3 子进程 → P6 容器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="670" width="190" height="90" as="geometry" />
        </mxCell>
        <mxCell id="24" value="code location&lt;br&gt;按需 warm (L3)&lt;br&gt;cold 时为 0 资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="840" y="670" width="150" height="90" as="geometry" />
        </mxCell>
        <mxCell id="30" value="Git Server&lt;br&gt;（工作副本唯一真源）" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;boundedLbl=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="300" y="880" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="31" value="task-runner (L2 / L3-base)&lt;br&gt;一次性沙箱容器（P6）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="880" width="240" height="80" as="geometry" />
        </mxCell>
        <mxCell id="40" value="&lt;b&gt;容量模型（单 Cell）&lt;/b&gt;&lt;br&gt;&lt;br&gt;每租约开销 ≈ 210 MB 内存 + 100 MB 盘&lt;br&gt;runtime 实例 limit 8 GB，基线 1.5 GB&lt;br&gt;→ 每实例 ≤ 16 租约（&lt;b&gt;可配置，Q3&lt;/b&gt;）&lt;br&gt;准入 = 内存预算 + 真实 RSS 双判断&lt;br&gt;运行期 EWMA 自适应（仓库规模差一个数量级）&lt;br&gt;&lt;br&gt;峰值并发编辑会话 400&lt;br&gt;→ 400 / 16 = 25 实例，留余量 33 实例&lt;br&gt;→ 264 GB 内存 / 66 vCPU&lt;br&gt;&lt;br&gt;对比随机路由：2000 × 200 MB = 400 GB&lt;br&gt;且命中率极低。租约后 84 GB 且 100% 命中。" style="text;html=1;strokeColor=#6c8ebf;fillColor=#f5f9ff;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="420" width="430" height="200" as="geometry" />
        </mxCell>
        <mxCell id="41" value="&lt;b&gt;三道防线保证「单挂载」不变式&lt;/b&gt;&lt;br&gt;&lt;br&gt;① Redis SET NX —— 正常情况原子获取&lt;br&gt;② 文件 flock（.repo/.datacode-lease）&lt;br&gt;   —— Redis 降级 / 同节点冲突&lt;br&gt;③ Git worktree 自身约束&lt;br&gt;   —— 一个分支至多一个 worktree&lt;br&gt;&lt;br&gt;&lt;b&gt;残余风险（显式接受）&lt;/b&gt;：Redis 长时间不可用&lt;br&gt;且副本数变化时可能短暂双挂载。最坏后果是&lt;br&gt;一个用户的未提交改动冲突（Git 报错而非&lt;br&gt;静默损坏），&lt;b&gt;不是跨租户泄露&lt;/b&gt;。&lt;br&gt;&lt;br&gt;&lt;b&gt;未提交改动保护（Q6 契约）&lt;/b&gt;：编辑器 5s 草稿存&lt;br&gt;DB + drain 时 push refs/datacode-wip/*（零丢失）&lt;br&gt;+ 每 10 min 快照（非优雅崩溃上界，&lt;b&gt;已接受&lt;/b&gt;）。" style="text;html=1;strokeColor=#b85450;fillColor=#fff5f5;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="650" width="430" height="250" as="geometry" />
        </mxCell>
        <mxCell id="50" value="① GET lease:{key}" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;endArrow=classic;strokeColor=#1565c0;labelBackgroundColor=#ffffff;labelBorderColor=none;" edge="1" parent="1" source="3" target="5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1150" y="100" />
            </Array>
            <mxPoint x="-60" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="51" value="② miss → acquire" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;endArrow=classic;strokeColor=#1565c0;labelBackgroundColor=#ffffff;labelBorderColor=none;" edge="1" parent="1" source="3" target="4">
          <mxGeometry relative="1" as="geometry">
