  <diagram id="p3-sandbox" name="3-沙箱隔离">
    <mxGraphModel dx="1434" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="1080" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="&lt;b&gt;分级沙箱隔离（P0 决策后）&lt;/b&gt;&lt;br&gt;&lt;br&gt;L1 平台进程内 —— 用户&lt;b&gt;数据&lt;/b&gt;（YAML/路径），严格校验&lt;br&gt;L2 标准容器 (runc) —— 用户 &lt;b&gt;SQL&lt;/b&gt;，&lt;b&gt;唯一允许可写仓库凭证&lt;/b&gt;&lt;br&gt;L3 用户&lt;b&gt;任意代码&lt;/b&gt; —— 分三档演进：&lt;br&gt;   &lt;b&gt;L3-proc&lt;/b&gt;（P3）独立进程 + 独立 UID + 清空 env + rlimit&lt;br&gt;   &lt;b&gt;L3-base&lt;/b&gt;（P6）标准容器 + 网络隔离 + 单工作副本挂载&lt;br&gt;   &lt;b&gt;L3-strong&lt;/b&gt;（待增强）+ gVisor / Kata&lt;br&gt;&lt;br&gt;&lt;b&gt;Q1&lt;/b&gt;：保留 SQLMesh Python model/macro ⇒ 必须真隔离&lt;br&gt;&lt;b&gt;Q2&lt;/b&gt;：暂不用 gVisor/Kata ⇒ T8 记为待增强&lt;br&gt;&lt;b&gt;安全默认&lt;/b&gt;：无法判定时用当前最强&lt;b&gt;已启用&lt;/b&gt;档位" style="text;html=1;strokeColor=#82b366;fillColor=#f4fbf4;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="560" height="195" as="geometry" />
        </mxCell>
        <mxCell id="3" value="&lt;b&gt;威胁消除时间线&lt;/b&gt;（现状 T1-T10 全部可行）&lt;br&gt;&lt;b&gt;T2 读平台凭证（最致命）&lt;/b&gt; → &lt;b&gt;P3&lt;/b&gt; 清空 env + 独立 UID&lt;br&gt;T5 资源耗尽（噪声邻居） → P3 rlimit ／ P6 cgroup&lt;br&gt;T10 篡改平台文件 → P3 独立 UID ／ P6 readOnlyRootFs&lt;br&gt;T1 读其他租户工作区 → &lt;b&gt;P6&lt;/b&gt; 只挂载 1 个工作副本&lt;br&gt;T3 直连 PG / Redis → P6 NetworkPolicy default-deny&lt;br&gt;T6 云元数据 169.254.x → P6 出口代理拒绝内网段&lt;br&gt;T7 SSRF 内网横移 → P6 出口代理白名单&lt;br&gt;&lt;b&gt;T8 容器逃逸&lt;/b&gt; → ⚠️ &lt;b&gt;待增强&lt;/b&gt;（Q2）缓解：用户代码专属节点池&lt;br&gt;git hooks（当前被忽略） → P3 core.hooksPath=/dev/null" style="text;html=1;strokeColor=#b85450;fillColor=#fff5f5;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="620" height="195" as="geometry" />
        </mxCell>
        <mxCell id="10" value="平台侧（可信 · 持凭证）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#1565c0;strokeWidth=2;verticalAlign=top;align=left;spacing=6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="230" width="560" height="560" as="geometry" />
        </mxCell>
        <mxCell id="11" value="agent-service&lt;br&gt;审批 L1-L6（对话语义）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="290" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="12" value="workspace-runtime&lt;br&gt;租约所有者 · TaskSubmitter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="330" y="290" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="13" value="&lt;b&gt;L1 · 平台进程内执行（仅数据处理，无代码执行）&lt;/b&gt;&lt;br&gt;文件读写 / 列目录 / 代码搜索  （parse_workspace_path 5 段布局强校验）&lt;br&gt;ontology YAML 加载（yaml.safe_load）  git status / diff（禁用 hooks）&lt;br&gt;模型/血缘/列元数据只读查询（来自 MetadataContext，毫秒级）" style="text;html=1;strokeColor=#6c8ebf;fillColor=#f5f9ff;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="400" width="460" height="100" as="geometry" />
        </mxCell>
        <mxCell id="14" value="control-service&lt;br&gt;deployment / 配额 / 审计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="90" y="540" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="15" value="&lt;b&gt;平台凭证（绝不进入沙箱）&lt;/b&gt;&lt;br&gt;DB_PASSWORD · REDIS_PASSWORD · LLM API keys · TOKEN_ENCRYPTION_SECRET · INTERNAL_TOKEN" style="text;html=1;strokeColor=#b85450;fillColor=#ffecec;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="650" width="460" height="80" as="geometry" />
        </mxCell>
        <mxCell id="20" value="隔离&lt;br&gt;边界&lt;br&gt;&lt;br&gt;&lt;b&gt;P3&lt;/b&gt;&lt;br&gt;L3-proc&lt;br&gt;独立 UID&lt;br&gt;清空 env&lt;br&gt;setrlimit&lt;br&gt;&lt;br&gt;&lt;b&gt;P6&lt;/b&gt;&lt;br&gt;L3-base&lt;br&gt;NetworkPolicy&lt;br&gt;default-deny&lt;br&gt;nonroot 65534&lt;br&gt;drop ALL&lt;br&gt;seccomp&lt;br&gt;独立节点池&lt;br&gt;&lt;br&gt;&lt;b&gt;待增强&lt;/b&gt;&lt;br&gt;gvisor (Q2)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#333333;strokeWidth=2;dashed=1;dashPattern=4 4;verticalAlign=middle;fontSize=11;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="630" y="230" width="140" height="560" as="geometry" />
        </mxCell>
        <mxCell id="30" value="沙箱侧（不可信 · 无平台凭证）" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=none;strokeColor=#2e7d32;strokeWidth=2;verticalAlign=top;align=left;spacing=6;fontSize=13;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="800" y="230" width="660" height="560" as="geometry" />
        </mxCell>
        <mxCell id="31" value="task-runner &lt;b&gt;L2&lt;/b&gt; (runc) · P6&lt;br&gt;纯 SQL plan/apply · query · git clone/push&lt;br&gt;&lt;b&gt;唯一持可写仓库凭证的档位&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="280" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="32" value="task-runner &lt;b&gt;L3-base&lt;/b&gt; (runc) · P6&lt;br&gt;agent shell · dagster run · Python macro&lt;br&gt;只读仓库凭证（写操作拆到 L2）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="410" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="33" value="&lt;b&gt;SqlMeshExecutor&lt;/b&gt; (per-lease)&lt;br&gt;&lt;b&gt;P3&lt;/b&gt;: L3-proc 持久子进程（协议在此冻结）&lt;br&gt;&lt;b&gt;P6&lt;/b&gt;: L3-base warm sandbox 容器（同协议）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="540" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="34" value="&lt;b&gt;code location&lt;/b&gt; (L3)&lt;br&gt;import 用户 asset-dag/definitions.py&lt;br&gt;P3 加固子进程 → P6 独立 Pod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="880" y="670" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="35" value="&lt;b&gt;沙箱容器统一约束（L3-base, P6）&lt;/b&gt;&lt;br&gt;&lt;br&gt;挂载：&lt;b&gt;仅 1 个工作副本&lt;/b&gt; → /workspace&lt;br&gt;（不是整个 base_path，T1 的根本解）&lt;br&gt;&lt;br&gt;readOnlyRootFilesystem: true&lt;br&gt;runAsNonRoot / runAsUser 65534&lt;br&gt;capabilities: drop ALL&lt;br&gt;automountServiceAccountToken: false&lt;br&gt;&lt;b&gt;enableServiceLinks: false&lt;/b&gt;（不注入集群服务 env）&lt;br&gt;dnsPolicy: None（受控 resolver）&lt;br&gt;hostNetwork / hostPID / hostIPC: false&lt;br&gt;&lt;br&gt;cgroup：cpu 2 / mem 4Gi / pids 512&lt;br&gt;ephemeral-storage 8Gi&lt;br&gt;activeDeadlineSeconds 1800（硬超时）&lt;br&gt;&lt;br&gt;注入的唯一凭证：&lt;br&gt;  scoped task token（单任务 · 单工作副本 · TTL=任务时长）&lt;br&gt;  + 本工作副本自己配置的仓库凭证" style="text;html=1;strokeColor=#82b366;fillColor=#f4fbf4;align=left;verticalAlign=top;whiteSpace=wrap;spacing=6;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="280" width="240" height="480" as="geometry" />
        </mxCell>
        <mxCell id="40" value="egress-proxy（平台管控的唯一出网通道）&lt;br&gt;租户白名单 · 全量审计 · 流量配额 · 拒绝全部内网段" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
