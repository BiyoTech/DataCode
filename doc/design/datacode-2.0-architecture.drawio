        <mxCell id="26" value="Event Store&lt;br&gt;timeline 按天分区 + Parquet 冷层" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;boundedLbl=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="790" y="940" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="27" value="&lt;b&gt;Cell 内关键不变式&lt;/b&gt;&lt;br&gt;&lt;br&gt;① 一个工作副本（working copy）在任一时刻&lt;br&gt;   只被一个 workspace-runtime 挂载并写入&lt;br&gt;   → 工作副本可放 Pod 本地 NVMe，无需共享 PV&lt;br&gt;   → env_lock 退化为进程内锁&lt;br&gt;   → Context dirty 标志重新变得正确&lt;br&gt;&lt;br&gt;② 用户代码永不在平台进程内执行&lt;br&gt;   → P3 起 L3-proc 子进程（T2 消除）&lt;br&gt;   → P6 起 L2/L3-base 沙箱容器&lt;br&gt;&lt;br&gt;③ 服务间调用是 DAG，无环&lt;br&gt;   （原 sqlmesh⇄dagster、ontology→sqlmesh 环路&lt;br&gt;     因合并为进程内调用而消失）" style="text;html=1;strokeColor=#d79b00;fillColor=#fff9f0;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;rounded=1;" parent="1" vertex="1">
          <mxGeometry x="1010" y="940" width="410" height="205" as="geometry" />
        </mxCell>
        <mxCell id="30" value="Cell B&lt;br&gt;Cell C&lt;br&gt;Cell D&lt;br&gt;Cell E&lt;br&gt;&lt;br&gt;（结构同构&lt;br&gt;各 ~200 租户&lt;br&gt;独立 PG/Redis&lt;br&gt;独立 daemon）&lt;br&gt;&lt;br&gt;故障爆炸半径&lt;br&gt;= 20% 租户" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#fafafa;strokeColor=#666666;verticalAlign=top;spacing=6;fontSize=11;" parent="1" vertex="1">
