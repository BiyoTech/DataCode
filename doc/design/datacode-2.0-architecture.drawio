        <mxCell id="42" value="客户数据仓库" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;boundedLbl=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1030" y="960" width="130" height="70" as="geometry" />
