        <mxCell id="54" value="⑤ 直连持租约实例（Pod IP）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0.5;exitY=1;entryX=0.8;entryY=0;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=none;" edge="1" parent="1" source="3" target="7">
