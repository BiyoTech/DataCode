        </mxCell>
        <mxCell id="53" value="④ 授予租约" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0.5;exitY=1;entryX=0.2;entryY=0;endArrow=classic;strokeColor=#d79b00;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=none;" edge="1" parent="1" source="4" target="7">
          <mxGeometry relative="1" as="geometry">
