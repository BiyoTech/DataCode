  </diagram>
  <diagram id="p4-flow" name="4-请求链路">
    <mxGraphModel dx="1434" dy="810" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="用户 / Frontend&lt;br&gt;点击「Apply @ dev_alice」" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="60" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="3" value="edge-gateway&lt;br&gt;JWT 本地验签 + 授权缓存&lt;br&gt;身份头覆写（防伪造 owner）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="190" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="4" value="edge-gateway&lt;br&gt;&lt;b&gt;LeaseRouter&lt;/b&gt;&lt;br&gt;解析 lease_key → 选上游实例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="330" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="5" value="workspace-runtime&lt;br&gt;（持该工作副本租约的实例）&lt;br&gt;worktree 已在本地盘 · Context 已热" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="590" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="6" value="L3-proc 子进程（P3）&lt;br&gt;→ L2 / L3-base 容器（P6）&lt;br&gt;&lt;b&gt;无平台凭证&lt;/b&gt; · 只挂载本工作副本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="740" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="7" value="结果回收 + 事件落库&lt;br&gt;plan_apply_history / task_records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="100" y="890" width="220" height="80" as="geometry" />
        </mxCell>
        <mxCell id="10" value="identity-service&lt;br&gt;authz/resolve&lt;br&gt;（全局，60s 缓存）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="190" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Cell Redis&lt;br&gt;lease:{key}&lt;br&gt;（本地缓存 10s，命中 &amp;gt;95%）" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;boundedLbl=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="330" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="12" value="control-service&lt;br&gt;LeaseController&lt;br&gt;acquire → 选实例 → 通知&lt;br&gt;环境准入 guard + 配额" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="450" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Git Server&lt;br&gt;fetch / worktree add&lt;br&gt;（仅租约首次物化）" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;boundedLbl=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="590" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="14" value="客户数据仓库&lt;br&gt;sqlmesh__{workspace_id}&lt;br&gt;（经出口代理，白名单）" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;boundedLbl=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="740" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Cell PG / Event Store" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#F2F2F7;strokeColor=#8E8E93;boundedLbl=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="890" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="20" value="&lt;b&gt;链路说明（每步的关键约束）&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;① HTTPS&lt;/b&gt; —— 全局边缘按 JWT.cell_id 路由到本 Cell，热路径不查库。&lt;br&gt;&lt;br&gt;&lt;b&gt;② 认证与授权&lt;/b&gt; —— JWT 本地验签（无网络跳）；授权集合来自 identity-service&lt;br&gt;并以 perms_version 失效。SanitizeIdentity 覆写请求里客户端自带的 user_id，&lt;br&gt;使伪造 owner 不可能。RBAC 是全平台单一强制点，非 HTTP 入口亦可调 authz API。&lt;br&gt;&lt;br&gt;&lt;b&gt;③ 解析 lease_key&lt;/b&gt; —— 从 workspace_path 解析 {tenant}/{ws}/{user}/{env}（5 段布局&lt;br&gt;强校验），并校验调用者拥有该工作副本（OwnsWorkingCopy，纵深防御）。&lt;br&gt;&lt;br&gt;&lt;b&gt;④ 查租约&lt;/b&gt; —— 命中即直连该 runtime 的 Pod IP。Redis 不可用时降级为稳定&lt;br&gt;哈希路由，且 LeaseController 同步冻结扩缩容以保住单挂载不变式。&lt;br&gt;&lt;br&gt;&lt;b&gt;⑤ miss → acquire&lt;/b&gt; —— claim 锁防惊群；读 rt:* 心跳选最空闲实例；租户级&lt;br&gt;加权公平避免大租户饿死小租户；无容量则 429 + Retry-After。&lt;br&gt;&lt;br&gt;&lt;b&gt;⑥ 授予租约&lt;/b&gt; —— SET NX EX 原子获取 + flock 二次确认 + Git worktree 约束，&lt;br&gt;三道防线保证一个工作副本只被一个实例挂载写入。&lt;br&gt;&lt;br&gt;&lt;b&gt;⑦ 物化工作副本&lt;/b&gt; —— shallow clone .repo + worktree add 到 Pod 本地 NVMe；&lt;br&gt;检测 refs/datacode-wip/{user}/{env} 并提示恢复未提交改动。&lt;br&gt;&lt;br&gt;&lt;b&gt;⑧ 提交隔离执行&lt;/b&gt; —— P3 起走 L3-proc 常驻子进程（独立 UID + 清空 env +&lt;br&gt;rlimit，消除 T2）；P6 起纯 SQL 走 L2（可写凭证），含 Python model/macro 或&lt;br&gt;shell 走 L3-base（只读凭证）。环境写互斥此时是&lt;b&gt;进程内锁&lt;/b&gt;（租约已保证单&lt;br&gt;写者），无需分布式锁。&lt;br&gt;&lt;br&gt;&lt;b&gt;⑨ SQL 执行&lt;/b&gt; —— 沙箱只持有本工作副本配置的仓库凭证，出网必经 egress-proxy&lt;br&gt;并被全量审计；内网段与云元数据服务一律拒绝。&lt;br&gt;&lt;br&gt;&lt;b&gt;⑩⑪ 结果与审计&lt;/b&gt; —— 结果回传 runtime；历史与任务审计落 Cell PG；timeline 事件&lt;br&gt;进按天分区的 Event Store（30 天热 + Parquet 冷层）。&lt;br&gt;&lt;br&gt;&lt;b&gt;⑫ SSE 回报&lt;/b&gt; —— 跨副本 SSE 是 at-most-once；丢失的 delta 由客户端重连后从&lt;br&gt;持久化 timeline 回填，在下一次交互自愈。&lt;br&gt;&lt;br&gt;全链路一个 trace_id 串联（OTel），日志/指标均带 cell_id + tenant_id。&lt;br&gt;所有时间戳存 UTC，前端按用户时区渲染。" style="text;html=1;strokeColor=#8E8E93;fillColor=#fafafa;align=left;verticalAlign=top;whiteSpace=wrap;spacing=8;fontSize=11;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="660" height="910" as="geometry" />
        </mxCell>
        <mxCell id="50" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitPerimeter=1;entryPerimeter=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=classic;strokeColor=#1565c0;strokeWidth=2;labelBackgroundColor=#ffffff;labelBorderColor=none;" edge="1" parent="1" source="2" target="3">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-14" as="offset" />
