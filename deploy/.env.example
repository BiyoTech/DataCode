# Environment for the containerized stacks. Consumed by:
#   make up / down            (single-machine all-container stack)
#   make dagster-up / down    (Dagster orchestration, stackable)
#   make cell-up / global-up  (the P7 Cell topology)
# with docker compose --env-file deploy/.env. Copied to deploy/.env
# automatically by make on first use; deploy/.env is gitignored, this template
# is the committed documentation.

# ── Secrets (required) ────────────────────────────────────────────────────

# PostgreSQL password — NOT set here. The make targets inject DB_PASSWORD
# from the single truth file .data/postgres_password (created on demand by
# `scripts/pg-password.sh ensure`), which the postgres containers also mount
# as POSTGRES_PASSWORD_FILE. A value here would be silently overridden on
# every make invocation; change the password only with:
#   make pg-set-password PASSWORD=...
# (A bare `docker compose` run without make must export DB_PASSWORD itself.)

# Access-token signing secret — NOT set here. The make targets inject
# GW_JWT_SECRET from the single truth file .data/gateway_jwt_secret (created
# on demand by `scripts/jwt-secret.sh ensure`; `make dev` seeds the same
# file), the same contract as DB_PASSWORD above. ONE value across the whole
# installation — and across stacks: host dev and the container stacks share
# the file, so a login token from one stays valid on the other. A value here
# would be silently overridden on every make invocation. Rotating the secret
# means deleting the file: all issued tokens die with it, which is the point.

# ── Internal service-to-service token ─────────────────────────────────────
# Guards the /internal/* surfaces between services. It fans out to THREE
# distinct tokens, which the platform deliberately keeps separate (possessing
# one must not grant the others) — a single value here is the convenience of a
# single-operator install, not an architectural claim:
#   WORKSPACE_RUNTIME_INTERNAL_TOKEN     runtime's channel: env-control,
#                                        leases, code-location inventory
#   CONTROL_SERVICE_RUNTIME_INTERNAL_TOKEN  the value control SENDS on it
#   IDENTITY_SERVICE_INTERNAL_TOKEN      identity's snapshots, placement,
#                                        cell registry
DATACODE_INTERNAL_TOKEN=dev-internal-token

# Sandbox egress-token signing secret (runtime mints, egress-proxy verifies).
# Only relevant where the egress plane runs (Kubernetes).
DATACODE_TASK_TOKEN_SECRET=dev-task-token-secret

# ── Optional ──────────────────────────────────────────────────────────────
# LLM API key for agent-service (global fallback).
#AGENT_SERVICE_LLM_API_KEY=

# ── Cell port offsets (second cell on one host only) ─────────────────────
# Copy deploy/.env.cell-1.example for a second cell. These variables shift
# ONE cell's published ports; compose cannot do arithmetic, so each port is an
# explicit variable rather than the broken ${CELL_PORT_BASE} prefix scheme.
#CELL_PG_PORT=15432
#CELL_REDIS_PORT=16379
#CELL_GATEWAY_PORT=18000
#CELL_AGENT_PORT=18001
#CELL_RUNTIME_PORT=18002
#CELL_RUNTIME2_PORT=18012
#CELL_CONTROL_PORT=18004
